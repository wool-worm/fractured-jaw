---
# Pagination generator: emits one HTML file per series in collections.seriesList.
# Lives outside src/content/ so content.11tydata.js doesn't try to compute
# a permalink for it — the per-iteration permalink below has to win.
pagination:
  data: collections.seriesList
  size: 1
  alias: seriesEntry
permalink: "/series/{{ seriesEntry.series }}/"
layout: layouts/series-page.njk
eleventyExcludeFromCollections: true
# The graph widget has no "series" centering mode yet; render the global
# view on series pages until that lands.
page_type: top
graph_enabled: false
preview_enabled: false
eleventyComputed:
  current_series: "{{ seriesEntry.series }}"
---
