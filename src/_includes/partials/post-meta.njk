{# Post metadata block — published/updated dates, author, reading time,
   media rating (when present), tag list. Used by every content layout. #}
<dl class="post-meta">
  {% if date_published %}
    <dt>Published</dt>
    <dd>
      <time datetime="{{ date_published | isoDate }}">{{ date_published | humanDate }}</time>
    </dd>
  {% endif %}

  {# No visible "Updated" row by design (removed 2026-07-09): real
     revisions get noted in the body prose. date_updated still drives
     the invisible freshness metadata — sitemap lastmod, feed <updated>,
     and article:modified_time in head.njk. #}

  {% set _authors = (author or site.defaultAuthor) | authorEntries(collections.authors) %}
  {% if _authors.length %}
    <dt>By</dt>
    <dd>
      {% for a in _authors -%}
        <a href="{{ a.url }}" class="author-link">{{ a.displayName }}</a>{% if not loop.last %}, {% endif %}
      {%- endfor %}
    </dd>
  {% endif %}

  {% if reading_time %}
    <dt>Reading time</dt>
    <dd>{{ reading_time }}</dd>
  {% endif %}

  {% if rating %}
    <dt>Rating</dt>
    <dd class="post-meta-rating" aria-label="rating: {{ rating }}">{{ rating | starRating }}</dd>
  {% endif %}

  {% set seriesUrl = series_name | seriesNameToUrl %}
  {% if seriesUrl %}
    {% set seriesParent = collections.series | seriesByUrl(seriesUrl) %}
    {% if seriesParent %}
      <dt>Series</dt>
      <dd>
        <a href="{{ seriesParent.url }}" class="series-link">{{ seriesParent.data.title }}</a>
      </dd>
    {% endif %}
  {% endif %}

  {% if tags and tags.length %}
    <dt>Tags</dt>
    <dd>
      <ul class="tag-list">
        {% for tag in tags %}
          <li><a href="/tags/{{ tag | slug }}/">{{ tag }}</a></li>
        {% endfor %}
      </ul>
    </dd>
  {% endif %}
</dl>
