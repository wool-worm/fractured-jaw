{# Per-page <head> contents — included by base.njk. #}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{# Zen-mode no-flash bootstrap. Sets the `zen` class on <html> synchronously,
   before first paint, when the per-session zen preference is set. Without
   this, a zen-session page would paint the full (loud) styling first and
   only calm down once the deferred /assets/js/zen-toggle.js ran. State is
   sessionStorage (per-tab, cleared when the session ends) so the full site
   is always the default on a fresh visit. Must stay inline + render-blocking;
   cannot be deferred. See zen.css and zen-toggle.js. #}
<script>
  (function () {
    try {
      if (sessionStorage.getItem("fj.zen") === "1") {
        document.documentElement.classList.add("zen");
      }
    } catch (e) {}
  })();
</script>
{# Title: interior pages prefix their own title; the homepage (whose title
   equals site.title) appends site.tagline so the <title> isn't a bare,
   too-short brand name. Falls back to bare site.title if no tagline set. #}
<title>{% if title and title != site.title %}{{ title }} :: {{ site.title }}{% elif page.url == "/" and site.tagline %}{{ site.title }} :: {{ site.tagline }}{% else %}{{ site.title }}{% endif %}</title>
{# Description fallback chain: per-page frontmatter `description:` is best;
   otherwise derive a plain-text excerpt from the page body; site.description
   is the last resort. Keep og:/twitter: description (below) using the same
   `_description` so the three stay in sync. #}
{% set _description = description or (page.rawInput | excerpt) or site.description %}
<meta name="description" content="{{ _description }}">
{# HTML5 <meta name="author"> is single-valued. For array authors, join
   with commas so the meta tag holds the full byline as one string.
   Wikilink `author:` frontmatter is resolved to display names via the
   `authorEntries` filter (see .eleventy.js). When `author:` is empty,
   site.defaultAuthor (also a wikilink) is used. #}
{% set _headAuthors = (author or site.defaultAuthor) | authorEntries(collections.authors) %}
{% if _headAuthors.length %}
<meta name="author" content="{% for a in _headAuthors %}{{ a.displayName }}{% if not loop.last %}, {% endif %}{% endfor %}">
{% endif %}

{# Social-card image. Open Graph and Twitter both require absolute URLs, so
   relative paths from frontmatter (e.g. /attachments/...) and the site-wide
   default get site.url prefixed via the absoluteUrl filter. The default
   lives in _data/site.js so every page has a preview even when frontmatter
   omits `image:`. #}
{% set _ogImage = (image or site.defaultImage) | absoluteUrl(site.url) %}
{# True when this page falls back to the site-wide default image. We emit
   image dimensions only in that case because we know defaultImage's pixel
   size statically; per-post images aren't probed at build time. #}
{% set _isDefaultImage = not image %}
{# Section-bearing pages (blog/essays/fragments/media + series + authors)
   are treated as articles for og:type and article:* meta. The pages/
   section and section-landings are "website" type. #}
{% set _isArticle = section and section != "pages" %}

{# Open Graph (used by Discord, Slack, Mastodon, Facebook, etc. when links are shared) #}
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ _description }}">
<meta property="og:type" content="{% if _isArticle %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:image" content="{{ _ogImage }}">
{% if _isDefaultImage %}
<meta property="og:image:width" content="{{ site.defaultImageWidth }}">
<meta property="og:image:height" content="{{ site.defaultImageHeight }}">
{% endif %}
{% if image_alt %}<meta property="og:image:alt" content="{{ image_alt }}">{% endif %}

{# Article-time meta. Spec-defined Open Graph properties for article-type
   pages; some social scrapers and feed readers display freshness based on
   these. Only emitted for pages with a content section (excludes pages/
   and section landings). #}
{% if _isArticle and date_published %}
<meta property="article:published_time" content="{{ date_published | isoDate }}">
{% endif %}
{# modified_time is clamped to never precede published_time — the vault
   plugin tracks date_updated as file-mtime, which can sit earlier than a
   forward-dated date_published. #}
{% if _isArticle and date_updated %}
<meta property="article:modified_time" content="{{ date_updated | newerOf(date_published) }}">
{% endif %}

{# Twitter card #}
<meta name="twitter:card" content="{{ card_type or site.defaultCardType }}">
<meta name="twitter:title" content="{{ title or site.title }}">
<meta name="twitter:description" content="{{ _description }}">
<meta name="twitter:image" content="{{ _ogImage }}">
{% if _isDefaultImage %}
<meta name="twitter:image:width" content="{{ site.defaultImageWidth }}">
<meta name="twitter:image:height" content="{{ site.defaultImageHeight }}">
{% endif %}
{% if image_alt %}<meta name="twitter:image:alt" content="{{ image_alt }}">{% endif %}

<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" type="image/png" href="/assets/images/skull-favicon-64.png">
<meta name="theme-color" content="#0a0a0a">
<link rel="stylesheet" href="{{ assets['site.css'] }}">

{# Feed autodiscovery. The global /feed.xml is on every page so a reader
   can subscribe from anywhere. Section/series-aggregate feeds add their
   own <link> when the current URL matches a spec in _data/feeds.js, and
   individual series parents advertise their per-series feed. #}
<link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }} — all posts">
{% for f in feeds %}{% if f.feedUrl != "/feed.xml" and f.pageUrl == page.url %}
<link rel="alternate" type="application/atom+xml" href="{{ f.feedUrl }}" title="{{ f.title }}">
{% endif %}{% endfor %}
{% if section == "series" and page.url != "/series/" %}
<link rel="alternate" type="application/atom+xml" href="{{ page.url }}feed.xml" title="{{ site.title }} — {{ title }}">
{% endif %}
{% if section == "authors" and page.url != "/authors/" %}
<link rel="alternate" type="application/atom+xml" href="{{ page.url }}feed.xml" title="{{ site.title }} — {{ title }}">
{% endif %}

{# JSON-LD Article schema — structured metadata for search engines
   (richer SERP rendering: headline, dates, author). Inert data, no
   requests, no runtime code; built entirely from the values this file
   already computed (_description, _ogImage, _headAuthors). Gated to the
   four CONTENT sections only — series parents and author records also
   pass the broader _isArticle og:type gate but are navigation records,
   and "@type: Article, headline: wool-worm" is wrong structured data.
   dateModified is clamped to never precede datePublished (see the
   newerOf filter). `dump` JSON-encodes each value (quotes, newlines);
   `safe` stops autoescape from HTML-escaping quotes inside the script. #}
{% if section in ["blog", "essays", "fragments", "media"] and date_published %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ (title or site.title) | dump | safe }},
  "description": {{ _description | dump | safe }},
  "mainEntityOfPage": {{ (site.url + page.url) | dump | safe }},
  "datePublished": {{ (date_published | isoDate) | dump | safe }},
  "dateModified": {{ ((date_updated or date_published) | newerOf(date_published)) | dump | safe }},
  "image": {{ _ogImage | dump | safe }},
  "author": [{% for a in _headAuthors %}{ "@type": "Person", "name": {{ a.displayName | dump | safe }}, "url": {{ (site.url + a.url) | dump | safe }} }{% if not loop.last %}, {% endif %}{% endfor %}],
  "publisher": { "@type": "Organization", "name": {{ site.title | dump | safe }}, "logo": { "@type": "ImageObject", "url": {{ (site.defaultImage | absoluteUrl(site.url)) | dump | safe }} } }
}
</script>
{% endif %}
