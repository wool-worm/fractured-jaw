{# Per-page <head> contents — included by base.njk. #}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if title and title != site.title %}{{ title }} :: {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
{# HTML5 <meta name="author"> is single-valued. For array authors, join with
   commas so the meta tag holds the full byline as one string. #}
{% set _headAuthors = (author or site.defaultAuthor) | asList %}
<meta name="author" content="{{ _headAuthors | join(', ') }}">

{# Open Graph (used by Discord, Slack, Mastodon, Facebook, etc. when links are shared) #}
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:type" content="{% if section and section != 'pages' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.title }}">
{% if image %}<meta property="og:image" content="{{ image }}">{% endif %}

{# Twitter card #}
<meta name="twitter:card" content="{% if image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ title or site.title }}">
<meta name="twitter:description" content="{{ description or site.description }}">
{% if image %}<meta name="twitter:image" content="{{ image }}">{% endif %}

<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" type="image/png" href="/assets/images/skull-favicon-64.png">
<link rel="stylesheet" href="/assets/css/site.css">

{# Feed autodiscovery. The global /feed.xml is on every page so a reader
   can subscribe from anywhere. Section/series-aggregate feeds add their
   own <link> when the current URL matches a spec in _data/feeds.js, and
   individual series parents advertise their per-series feed. #}
<link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }} — all posts">
{% for f in feeds %}{% if f.feedUrl != "/feed.xml" and f.pageUrl == page.url %}
<link rel="alternate" type="application/atom+xml" href="{{ f.feedUrl }}" title="{{ f.title }}">
{% endif %}{% endfor %}
{% if section == "series" and page.url != "/series/" %}
<link rel="alternate" type="application/atom+xml" href="{{ page.url }}feed.xml" title="{{ site.title }} — {{ title }}">
{% endif %}
