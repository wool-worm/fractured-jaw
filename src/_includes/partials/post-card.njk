{# Single post card. Used wherever we list posts (homepage, section pages,
   tag pages, series pages). Caller passes `post` — an Eleventy collection
   item — and may optionally pass `titlePrefix` (a string prepended inside
   the card's <h2> link). The series-page layout uses this to render
   "Entry #N: " in front of each card title without altering the post's
   actual `data.title`. #}
<li class="post-card">
  <article>
    {% if post.data.image %}
      <a href="{{ post.url }}" class="post-card-image-link" tabindex="-1" aria-hidden="true">
        <img src="{{ post.data.image }}" alt="" class="post-card-image" loading="lazy">
      </a>
    {% endif %}
    {% if post.data.section and post.data.section != "pages" %}
      <p class="post-card-section">
        <a href="/{{ post.data.section }}/">{{ post.data.section }}</a>
      </p>
    {% endif %}
    <h2 class="post-card-title">
      <a href="{{ post.url }}">{% if titlePrefix %}{{ titlePrefix }}{% endif %}{{ post.data.title }}</a>
    </h2>
    {% if post.data.description %}
      <p class="post-card-description">{{ post.data.description }}</p>
    {% endif %}
    <p class="post-card-meta">
      {% if post.data.date_published %}
        <time datetime="{{ post.data.date_published | isoDate }}">
          {{ post.data.date_published | humanDate }}
        </time>
      {% endif %}
      {% set _cardAuthors = post.data.author | asList %}
      {% if _cardAuthors.length %}
        &middot;
        {% for a in _cardAuthors -%}
          <a href="/authors/{{ a | slug }}/" class="author-link">{{ a }}</a>{% if not loop.last %}, {% endif %}
        {%- endfor %}
      {% endif %}
      {% if post.data.rating %}
        &middot; <span class="post-card-rating">{{ post.data.rating }}</span>
      {% endif %}
      {% if post.data.reading_time %}
        &middot; {{ post.data.reading_time }}
      {% endif %}
    </p>
    {% if post.data.tags and post.data.tags.length %}
      <ul class="post-card-tags">
        {% for tag in post.data.tags %}
          <li><a href="/tags/{{ tag | slug }}/">{{ tag }}</a></li>
        {% endfor %}
      </ul>
    {% endif %}
  </article>
</li>
