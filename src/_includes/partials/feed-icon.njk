{# Atom / RSS subscribe link. Renders the classic three-arc broadcast
   glyph next to a short text label.

   Callers set:
     feedUrl   — the .xml path (required)
     feedLabel — the visible text (optional; defaults to "subscribe (atom)")

   Matches the eye icon in [header.njk] — same viewBox / stroke / currentColor
   so the link picks up whatever color context surrounds it. #}
<a
  class="feed-link"
  href="{{ feedUrl }}"
  type="application/atom+xml"
  rel="alternate"
>
  <svg
    class="feed-link-icon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    aria-hidden="true"
    focusable="false"
  >
    {# Inner arc, outer arc, antenna dot — classic RSS broadcast mark. #}
    <path
      d="M4 11 a 9 9 0 0 1 9 9"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
    />
    <path
      d="M4 4 a 16 16 0 0 1 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
    />
    <circle cx="5.5" cy="18.5" r="1.8" fill="currentColor" />
  </svg>
  <span class="feed-link-label">{{ feedLabel or "subscribe (atom)" }}</span>
</a>
