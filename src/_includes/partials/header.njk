{# Site-wide header. Stacked + centered layout: a masthead row (skull +
   deconstructed-glitch wordmark, with the station-ID right-aligned beneath the
   wordmark) sitting above a single centered nav row. The whole inner block is
   centered and bound to the content-column width (see .site-header-inner in
   layout.css) so it slides left and clears the floating widgets in step with
   the page body. Below the hamburger breakpoint the nav collapses to a
   dropdown; the masthead/skull keep their own clamp (cult.css). #}
<div class="broadcast-banner" aria-hidden="true"></div>
<header class="site-header">
  <div class="site-header-inner">
    <div class="site-masthead-row">
      <a href="/" class="site-logo-mark" aria-label="Fractured Jaw — home">
        <span class="skull-logo" aria-hidden="true"></span>
      </a>
      <div class="site-masthead">
        <a href="/" class="site-title" rel="home" tabindex="-1" aria-hidden="true">
          <span>{{ site.title }}</span>
          <span aria-hidden="true">{{ site.title }}</span>
          <span aria-hidden="true">{{ site.title }}</span>
          <span aria-hidden="true">{{ site.title }}</span>
        </a>
        {# Station-ID. Content lives in cult.css (.site-station-id::after),
           splicing in the radio's --fjr-coordinates; the encryption-failure
           variant swaps it to UNENCRYPTED. Right-aligned under the wordmark. #}
        <span class="site-station-id" aria-hidden="true"></span>
      </div>
      {# Mobile nav toggle. Hidden at desktop widths; revealed when .site-nav
         collapses into a dropdown panel below the header. Lives in the masthead
         row so it pins to the top-right on mobile. #}
      <button
        type="button"
        class="site-nav-toggle"
        id="site-nav-toggle"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="site-nav-menu"
      >
        <span class="site-nav-toggle-bar" aria-hidden="true"></span>
        <span class="site-nav-toggle-bar" aria-hidden="true"></span>
        <span class="site-nav-toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
    <nav class="site-nav" id="site-nav-menu" aria-label="Primary" data-open="false">
      <ul>
        {% for item in navigation %}
          <li>
            <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a>
          </li>
        {% endfor %}
        <li class="site-nav-search">
          <button
            type="button"
            class="search-icon-button"
            aria-label="Open search"
            aria-haspopup="dialog"
            aria-controls="search-modal"
            data-search-open
          >
            {# Open-eye glyph — slit pupil, brutalist. Inherits currentColor so
               the nav hover state colours it without per-state SVG swaps. #}
            <svg
              class="search-icon-eye"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M1.5 12 C 4.5 5.5, 10 3.5, 12 3.5 S 19.5 5.5, 22.5 12 C 19.5 18.5, 14 20.5, 12 20.5 S 4.5 18.5, 1.5 12 Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linejoin="round"
              />
              <circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.6" />
              <ellipse cx="12" cy="12" rx="0.9" ry="2.6" fill="currentColor" />
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>
