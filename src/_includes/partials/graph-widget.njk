{# Local-graph widget. Pinned top-right of the viewport on every page
   (except /network_nodes/, suppressed in base.njk). Behavior depends on
   the `page_type` frontmatter:
     top      — render the full graph, no centering ("global_network")
     section  — pack the current section's nodes near center ("section_network")
     content  — pin the current page to center, render its 1-hop
                neighborhood ("local_network")
     tag      — pack the current tag's nodes near center ("tag_network")
   Data attributes pass page_type / section / current_tag to graph-widget.js,
   which reads them to pick the layout strategy and the header label.
   JS lives at /assets/js/graph-widget.js. #}


<aside
  class="graph-widget"
  id="graph-widget"
  aria-label="Local graph"
  data-page-type="{{ page_type or 'top' }}"
  data-section="{{ section_name or section or '' }}"
  data-current-tag="{{ current_tag or '' }}"
>
  {# Pre-render the snake_case label that matches page_type so we don't flash
     "global_network" before graph-widget.js boots. JS overwrites this after
     it resolves layout-fallbacks (e.g. content → top when page isn't graphed). #}
  {% set _label = "global_network" %}
  {% if page_type == "content" %}{% set _label = "local_network" %}{% endif %}
  {% if page_type == "section" %}{% set _label = "section_network" %}{% endif %}
  {% if page_type == "tag" %}{% set _label = "tag_network" %}{% endif %}
  <div class="graph-widget-header">
    {# Fold button is the leftmost header element so it stays visible
       when the widget translates right and only a thin strip remains
       at the window edge. Clicking toggles the .is-folded class.
       Mirrors the radio widget's pattern (both slide right). #}
    <button
      type="button"
      class="graph-widget-fold"
      id="graph-widget-fold"
      aria-pressed="false"
      title="Fold graph to right margin"
      aria-label="Fold graph"
    >»</button>
    <span id="graph-widget-label">{{ _label }}</span>
    <a href="/network_nodes/" title="Open full graph" aria-label="Open full graph">⤢</a>
  </div>
  <div class="graph-widget-toggle" role="group" aria-label="Edge mode">
    <button type="button" data-mode="links" aria-pressed="true">links</button>
    <button type="button" data-mode="tags" aria-pressed="false">tags</button>
  </div>
  <canvas id="graph-widget-canvas"></canvas>
</aside>
