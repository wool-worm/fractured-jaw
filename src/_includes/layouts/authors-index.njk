---
layout: layouts/base.njk
---
{# Author index page (/authors/). Lists every author record in
   collections.authors with a count derived from collections.authorPosts
   and a link to the per-author page. Authors are pre-sorted in .eleventy.js
   by most recent published post (newest first; no-post authors last,
   alphabetical tiebreak). Mirrors layouts/series-index structurally, but
   uses .author-cloud styling for compact tag-style chips. #}

<section class="authors-index">
  <header class="page-header">
    <h1 class="page-title">{{ title or "Authors" }}</h1>
    {% if description %}
      <p>{{ description }}</p>
    {% endif %}
    {% if content %}
      <div class="page-intro">{{ content | safe }}</div>
    {% endif %}
  </header>

  {% if collections.authors.length %}
    <ul class="author-cloud">
      {% for entry in collections.authors %}
        {% set _posts = collections.authorPosts[entry.url] or [] %}
        {% set _lastPublished = _posts[0].data.date_published if _posts.length else null %}
        <li>
          <a href="{{ entry.url }}" class="author-cloud-item">
            <span class="author-cloud-name">{{ entry.data.title }}</span>
            <span class="author-cloud-count">
              (posts: {{ _posts.length }}, last published date:
              {%- if _lastPublished %} {{ _lastPublished | humanDate("LL/dd/yyyy") }}{% else %} &mdash;{% endif %})
            </span>
          </a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No authors yet.</p>
  {% endif %}
</section>
