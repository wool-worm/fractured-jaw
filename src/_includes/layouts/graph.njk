---
layout: layouts/base.njk
---
{# Graph view layout. Hosts a <canvas> + a mode toggle. The actual
   rendering and physics live in /assets/js/graph.js, which fetches
   /graph-data.json (built by src/graph-data.11ty.js).

   Inline <style> here is intentional minimum-viable positioning so the
   graph is usable without a stylesheet. Phase 8 styling should move
   these into a dedicated stylesheet and tune the visual to match the
   brutalist aesthetic. #}

<style>
  .graph-shell {
    position: relative;
    width: 100%;
    height: 70vh;
    min-height: 420px;
    border: 1px solid #000;
    background: #fff;
    overflow: hidden;
  }
  .graph-shell canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
  }
  .graph-shell canvas.is-grabbing {
    cursor: grabbing;
  }
  .graph-controls {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 10;
    background: #fff;
    border: 1px solid #000;
    padding: 0.25rem 0.5rem;
    font-family: monospace;
    font-size: 0.875rem;
  }
  .graph-controls span {
    margin-right: 0.5rem;
  }
  .graph-controls button {
    margin-right: 0.25rem;
    padding: 0.125rem 0.5rem;
    border: 1px solid #000;
    background: #fff;
    color: #000;
    font-family: monospace;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .graph-controls button[aria-pressed="true"] {
    background: #000;
    color: #fff;
  }
  .graph-legend {
    position: absolute;
    bottom: 0.5rem;
    left: 0.5rem;
    z-index: 10;
    background: #fff;
    border: 1px solid #000;
    padding: 0.25rem 0.5rem;
    font-family: monospace;
    font-size: 0.75rem;
    line-height: 1.6;
  }
  .graph-legend .swatch {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    border: 1px solid #000;
    vertical-align: middle;
    margin-right: 0.25rem;
  }
  .graph-empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    font-family: monospace;
    color: #888;
  }
</style>

<header class="page-header">
  <h1 class="page-title">{{ title }}</h1>
  {% if description_short %}
    <p>{{ description_short }}</p>
  {% endif %}
  {% if content %}
    <div class="page-intro">{{ content | safe }}</div>
  {% endif %}
</header>

<div class="graph-shell">
  <div class="graph-controls" role="group" aria-label="Graph mode">
    <span>mode:</span>
    <button type="button" data-mode="links" aria-pressed="true">links</button>
    <button type="button" data-mode="tags" aria-pressed="false">tags</button>
  </div>
  <div class="graph-legend" id="graph-legend" aria-hidden="true">
    <div><span class="swatch" style="background:#0a0;"></span>blog</div>
    <div><span class="swatch" style="background:#06c;"></span>essays</div>
    <div><span class="swatch" style="background:#c0c;"></span>fragments</div>
    <div><span class="swatch" style="background:#c80;"></span>media</div>
    <div><span class="swatch" style="background:#888;"></span>page</div>
    <div class="legend-tag" hidden><span class="swatch" style="background:#f80;"></span>tag</div>
  </div>
  <canvas id="graph-canvas"></canvas>
  <div class="graph-empty" id="graph-empty" hidden>no edges in this mode yet</div>
</div>

<script src="/assets/js/graph.js" defer></script>
