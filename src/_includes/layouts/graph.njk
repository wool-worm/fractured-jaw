---
layout: layouts/base.njk
---
{# Graph view layout. Hosts a <canvas> + a mode toggle. The actual
   rendering and physics live in /assets/js/graph.js, which fetches
   /graph-data.json (built by src/graph-data.11ty.js).
   Styling is in src/_css/graph.css. #}

<header class="page-header">
  <h1 class="page-title">{{ title }}</h1>
  {% if description %}
    <p>{{ description }}</p>
  {% endif %}
  {% if content %}
    <div class="page-intro">{{ content | safe }}</div>
  {% endif %}
</header>

<div class="graph-shell">
  <div class="graph-controls" role="group" aria-label="Graph mode and zoom">
    <span>mode:</span>
    <button type="button" data-mode="links" aria-pressed="true">links</button>
    <button type="button" data-mode="tags" aria-pressed="false">tags</button>
    <span class="graph-controls-divider" aria-hidden="true">│</span>
    <span>zoom:</span>
    <button type="button" data-zoom="in" aria-label="zoom in">+</button>
    <button type="button" data-zoom="out" aria-label="zoom out">−</button>
    <button type="button" data-zoom="reset" aria-label="reset zoom + pan">⊙</button>
    <span class="graph-controls-divider" aria-hidden="true">│</span>
    <button type="button" data-action="scramble" aria-label="scramble node positions">⚄</button>
  </div>
  <div class="graph-legend" id="graph-legend" role="group" aria-label="Filter node types">
    <button type="button" class="legend-toggle" data-section="blog"      aria-pressed="true"><span class="swatch" style="background:#0a0;"></span>blog</button>
    <button type="button" class="legend-toggle" data-section="essays"    aria-pressed="true"><span class="swatch" style="background:#06c;"></span>essays</button>
    <button type="button" class="legend-toggle" data-section="fragments" aria-pressed="true"><span class="swatch" style="background:#c0c;"></span>fragments</button>
    <button type="button" class="legend-toggle" data-section="media"     aria-pressed="true"><span class="swatch" style="background:#c80;"></span>media</button>
    <button type="button" class="legend-toggle" data-section="series"    aria-pressed="true"><span class="swatch" style="background:#0bc;"></span>series</button>
    <button type="button" class="legend-toggle" data-section="authors"   aria-pressed="true"><span class="swatch" style="background:#fc0;"></span>authors</button>
    <button type="button" class="legend-toggle" data-section="pages"     aria-pressed="true"><span class="swatch" style="background:#888;"></span>page</button>
    <button type="button" class="legend-toggle legend-tag" data-section="tag" aria-pressed="true" hidden><span class="swatch" style="background:#f80;"></span>tag</button>
  </div>
  <canvas id="graph-canvas"></canvas>
  <div class="graph-empty" id="graph-empty" hidden>no edges in this mode yet</div>
</div>

<script src="{{ assets['graph.js'] }}" defer></script>
