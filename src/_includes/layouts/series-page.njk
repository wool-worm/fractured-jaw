---
layout: layouts/base.njk
---
{# Per-series page (/series/<slug>/). Comes from a real content file at
   src/content/series/<Name>.md — so `title`, `description`, `image`,
   `tags`, and the rendered body are all driven by the parent's
   frontmatter + content.

   The member-entries list is appended after the parent's body. Each
   entry's card title is prepended with "Entry #N: " (oldest in the
   series = #1, newest = #N). Display order is newest-first. #}

{% set entries = collections.seriesEntries[page.url] %}

<article class="section-page series-page series-{{ page.fileSlug }}">
  <header class="section-header">
    {% if image_src %}
      <img src="{{ image_src }}" alt="{{ image_alt or '' }}" class="series-hero" sizes="(max-width: 720px) 100vw, 720px"{% if image_focus %} style="object-position: {{ image_focus }}"{% endif %}>
    {% endif %}
    <h1 class="section-title">
      Series: <span class="series-name">{{ title }}</span>
    </h1>
    {% if description %}
      <p class="section-description">{{ description }}</p>
    {% endif %}
    <p class="series-meta">
      {% set count = entries.length or 0 %}
      {{ count }} entr{% if count == 1 %}y{% else %}ies{% endif %}
      &middot; <a href="/series/">all series</a>
    </p>
    {% if tags and tags.length %}
      <ul class="tag-list series-tags">
        {% for tag in tags %}
          <li><a href="/tags/{{ tag | slug }}/">{{ tag }}</a></li>
        {% endfor %}
      </ul>
    {% endif %}
  </header>

  {% if content %}
    <div class="series-intro">{{ content | safe }}</div>
  {% endif %}

  <section class="series-entries">
    {% if entries and entries.length %}
      <ul class="post-list">
        {% for entry in entries %}
          {% set post = entry.post %}
          {% set titlePrefix = "Entry #" + entry.entryNumber + ": " %}
          {% include "partials/post-card.njk" %}
        {% endfor %}
      </ul>
    {% else %}
      <p class="series-empty">No entries in this series yet.</p>
    {% endif %}
  </section>

  <div class="feed-block">
    {% set feedUrl = page.url + "feed.xml" %}
    {% set feedLabel = "subscribe to this series (atom)" %}
    {% include "partials/feed-icon.njk" %}
  </div>
</article>
