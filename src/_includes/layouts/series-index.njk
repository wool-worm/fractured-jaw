---
layout: layouts/base.njk
---
{# Series index page (/series/). Renders every series parent (a content
   file at src/content/series/<Name>.md) as a vertical card in a
   three-column grid. Series are pre-sorted newest-first by .eleventy.js. #}

<section class="section-page section-series">
  <header class="section-header">
    <h1 class="section-title">{{ title or "Series" }}</h1>
    {% if description %}
      <p class="section-description">{{ description }}</p>
    {% endif %}
    {% if content %}
      <div class="section-intro">{{ content | safe }}</div>
    {% endif %}
  </header>

  {% if collections.series.length %}
    <ul class="series-grid">
      {% for parent in collections.series %}
        {% set memberEntries = collections.seriesEntries[parent.url] %}
        {% set memberCount = memberEntries.length or 0 %}
        {% include "partials/series-card.njk" %}
      {% endfor %}
    </ul>
  {% else %}
    <p>No series yet.</p>
  {% endif %}

  <div class="feed-block">
    {% set feedUrl = "/series/feed.xml" %}
    {% set feedLabel = "subscribe to every series (atom)" %}
    {% include "partials/feed-icon.njk" %}
  </div>
</section>
