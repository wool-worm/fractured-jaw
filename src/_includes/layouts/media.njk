---
layout: layouts/base.njk
---
{# Layout for media reviews (src/content/media/). The post-meta partial
   already renders the `rating` frontmatter when present — that's the only
   structural difference from a blog post today. #}
<article class="post post-media">
  <header class="post-header">
    <h1 class="post-title">{{ title }}</h1>
    {% if description_short %}
      <p class="post-description">{{ description_short }}</p>
    {% endif %}
    {% include "partials/post-meta.njk" %}
  </header>
  <div class="post-content">
    {{ content | safe }}
  </div>
</article>
