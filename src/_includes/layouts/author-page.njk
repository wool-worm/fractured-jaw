---
layout: layouts/base.njk
---
{# Per-author page (/authors/<slug>/). Comes from a real content file at
   src/content/authors/<Name>.md — so `title`, `description`, `image`,
   `tags`, and the rendered body are all driven by the author's
   frontmatter + bio body.

   The post list is appended after the bio. Posts opt in via
   `author: "[[authors/<Name>|alias]]"` (or an array of those wikilinks
   for co-authored work). Display order is newest-first. Mirrors
   layouts/series-page.njk in structure. #}

{% set posts = collections.authorPosts[page.url] %}

<article class="section-page author-page author-{{ page.fileSlug }}">
  <header class="section-header">
    {% if image_src %}
      <img src="{{ image_src }}" alt="{{ image_alt or '' }}" class="series-hero" sizes="(max-width: 720px) 100vw, 720px"{% if image_focus %} style="object-position: {{ image_focus }}"{% endif %}>
    {% endif %}
    <h1 class="section-title">
      Author: <span class="author-name">{{ title }}</span>
    </h1>
    {% if description %}
      <p class="section-description">{{ description }}</p>
    {% endif %}
    <p class="series-meta">
      {% set count = posts.length or 0 %}
      {{ count }} post{% if count != 1 %}s{% endif %}
      &middot; <a href="/authors/">all authors</a>
    </p>
    {% if tags and tags.length %}
      <ul class="tag-list series-tags">
        {% for tag in tags %}
          <li><a href="/tags/{{ tag | slug }}/">{{ tag }}</a></li>
        {% endfor %}
      </ul>
    {% endif %}
  </header>

  {% if content %}
    <div class="series-intro">{{ content | safe }}</div>
  {% endif %}

  <section class="series-entries">
    {% if posts and posts.length %}
      <ul class="post-list">
        {% for post in posts %}
          {% include "partials/post-card.njk" %}
        {% endfor %}
      </ul>
    {% else %}
      <p class="series-empty">No posts under this author yet.</p>
    {% endif %}
  </section>

  <div class="feed-block">
    {% set feedUrl = page.url + "feed.xml" %}
    {% set feedLabel = "subscribe to this author (atom)" %}
    {% include "partials/feed-icon.njk" %}
  </div>
</article>
