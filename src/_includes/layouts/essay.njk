---
layout: layouts/base.njk
---
{# Layout for essays (src/content/essays/). Currently identical to post.njk
   except for the wrapper class — kept as a separate file so essays can
   diverge later (different metadata, footnote treatment, etc.) without
   churning the blog layout. #}
<article class="post post-essay">
  <header class="post-header">
    <h1 class="post-title">{{ title }}</h1>
    {% if description %}
      <p class="post-description">{{ description }}</p>
    {% endif %}
    {% include "partials/post-hero-image.njk" %}
    {% include "partials/post-meta.njk" %}
  </header>
  <div class="post-content">
    {{ content | safe }}
  </div>
</article>
