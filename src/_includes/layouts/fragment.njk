---
layout: layouts/base.njk
---
{# Layout for fragments (src/content/fragments/). Short pieces — keeps the
   same structure as post.njk for now. Diverge here if fragments grow their
   own conventions (e.g. no description, smaller header). #}
<article class="post post-fragment">
  <header class="post-header">
    <h1 class="post-title">{{ title }}</h1>
    {% if description_short %}
      <p class="post-description">{{ description_short }}</p>
    {% endif %}
    {% include "partials/post-meta.njk" %}
  </header>
  <div class="post-content">
    {{ content | safe }}
  </div>
</article>
