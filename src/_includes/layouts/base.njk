{# The HTML skeleton every page is wrapped in. Section layouts (post.njk,
   page.njk, etc.) chain into this via `layout: layouts/base.njk` in their
   own frontmatter. #}
<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
  {% include "partials/head.njk" %}
</head>
<body>
  {# Skip-to-content link. Visible only on keyboard focus; lets screen-reader
     and keyboard users bypass the header + widgets on every page. #}
  <a href="#main" class="skip-link">skip to content</a>
  {% include "partials/header.njk" %}
  <script src="{{ assets['nav-toggle.js'] }}" defer></script>
  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>
  {# Mobile-only: collapse long page intros (home + section landings)
     behind a read-more toggle. No-op above 720px or for short intros. #}
  <script src="{{ assets['intro-fold.js'] }}" defer></script>
  {% include "partials/footer.njk" %}
  {# Local-graph widget renders on every page EXCEPT /network_nodes/ — the
     dedicated full-graph view would render the same graph twice. Whether
     the *current* page appears as a node in the graph is governed
     separately by the `graph_enabled` frontmatter flag (see
     graph-data.11ty.js). The widget's layout (global, local, section,
     tag) is driven by the `page_type` frontmatter, read by
     graph-widget.js off data attributes on the partial. #}
  {% if page.url != "/network_nodes/" %}
    {% include "partials/graph-widget.njk" %}
    <script src="{{ assets['graph-widget.js'] }}" defer></script>
  {% endif %}
  {# Pirate-radio tuner widget — bottom-right corner, every page.
     No dedicated full-page view (unlike the graph), so no suppression. #}
  {% include "partials/radio-widget.njk" %}
  {# bandcamp-embed.js defines window.FJ.bandcampEmbed; loaded before
     radio-widget.js so the widget can call into it. defer preserves
     document order, so this script runs first. #}
  <script src="{{ assets['bandcamp-embed.js'] }}" defer></script>
  <script src="{{ assets['radio-widget.js'] }}" defer></script>
  {# Systems-status panel — left-center, every page. Counterweight
     to the graph (top-right) and radio (bottom-right) widgets. #}
  {% include "partials/systems-widget.njk" %}
  <script src="{{ assets['systems-widget.js'] }}" defer></script>
  <script src="{{ assets['wikilink-preview.js'] }}" defer></script>
  <script src="{{ assets['baffle.js'] }}" defer></script>
  {# Click-to-load handler for {% spotify %} embeds is dormant — the
     shortcode currently emits the iframe directly. To revive: re-enable
     this script tag and swap the iframe back to .spotify-embed-shell in
     the shortcode body in .eleventy.js.
     <script src="{{ assets['spotify-embed-shell.js'] }}" defer></script> #}
  {# Zen-mode dock, pinned bottom-left (the one viewport corner no widget
     occupies). Holds the zen toggle chip and (only in zen) a caret that
     reveals the announcements panel above it. Zen hides the systems widget
     (which normally carries the announcements log), so this is the calm
     zen-only way to still surface them. The panel reuses the `announcements`
     global (server-rendered, no fetch) and the same .announce-* row markup
     the systems widget uses; it's display:none unless html.zen .is-open, so
     it can never appear in the full site. See /assets/js/zen-toggle.js. #}
  <div class="zen-dock" id="zen-dock">
    <div class="zen-announce-panel" id="zen-announce-panel" role="dialog" aria-label="Announcements">
      <div class="zen-announce-head">
        <span class="zen-announce-icon" aria-hidden="true">✉&#xFE0E;</span>
        <span class="zen-announce-title">recent_messages</span>
        <button
          type="button"
          class="zen-announce-close"
          id="zen-announce-close"
          aria-label="Close announcements"
          title="Close"
        >&#xD7;</button>
      </div>
      <div class="zen-announce-log">
        {% if announcements and announcements.length %}
          {% for ann in announcements %}
            <div class="announce-entry">
              <div class="announce-meta">
                <span class="announce-author">&gt; {{ ann.author }}</span>
                <span class="announce-date">&gt; {{ ann.dateDisplay }}</span>
                <span class="announce-time">&gt; {{ ann.timeDisplay }}</span>
              </div>
              <div class="announce-body">{{ ann.body }}</div>
            </div>
          {% endfor %}
        {% else %}
          <div class="announce-empty">&gt; no messages logged</div>
        {% endif %}
      </div>
    </div>
    <div class="zen-dock-controls">
      {# Toggling adds/removes the `zen` class on <html>; zen.css keys off it
         to strip motion + decoration, mute the loud palette, and hide the
         radio + systems widgets down to a calm reading state (the graph
         stays). State lives in sessionStorage so it survives navigation but
         resets each session: the full site is always the default. #}
      <button
        type="button"
        class="zen-toggle"
        id="zen-toggle"
        aria-pressed="false"
        aria-label="Toggle zen mode"
        title="Flatline the signal"
      >
        <span class="zen-toggle-glyph" aria-hidden="true">◉</span>
        <span class="zen-toggle-label">flatline</span>
      </button>
      {# Announcements disclosure: hidden in the full site (the systems widget
         carries the log there), revealed only in zen via html.zen. #}
      <button
        type="button"
        class="zen-announce-toggle"
        id="zen-announce-toggle"
        aria-expanded="false"
        aria-controls="zen-announce-panel"
        aria-label="Show announcements"
        title="Show messages"
      >▴</button>
    </div>
  </div>
  <script src="{{ assets['zen-toggle.js'] }}" defer></script>
  {% include "partials/search-modal.njk" %}
  <script src="{{ assets['search.js'] }}" defer></script>
</body>
</html>
