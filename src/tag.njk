---
# Pagination generator: emits one HTML file per tag in collections.tagList.
# Lives outside src/content/ so content.11tydata.js doesn't try to compute
# a permalink for it — the per-iteration permalink below has to win.
pagination:
  data: collections.tagList
  size: 1
  alias: tagEntry
permalink: "/tags/{{ tagEntry.tag }}/"
layout: layouts/tag-page.njk
eleventyExcludeFromCollections: true
# Drives the local-graph widget. `tag` mode tells the widget to pack all
# nodes belonging to current_tag near the center.
page_type: tag
eleventyComputed:
  current_tag: "{{ tagEntry.tag }}"
---
