# Obsidian internals — never publish to the site
src/content/.obsidian/
src/content/.trash/

# Author-side workspace: templates, guides, snippets that aren't site content
src/content/_local/

# Raw source files read directly by .11ty.js emitters (radio scripts).
# Tracked in git so production builds see them, but excluded from the
# content pipeline so they don't render as standalone pages.
src/content/_data/

# Announcement notes (year/month subfolders) read by src/_data/announcements.js
# and rendered into the systems widget's log. Tracked so CI sees them, but
# excluded from the content pipeline: no URLs, feeds, search, graph, or tags.
src/content/_announcements/

# Build output (in case it ever lives inside src/)
src/_site/
